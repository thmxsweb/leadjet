{
  "name": "@thmxsweb/leadjet",
  "version": "0.1.0",
  "description": "Find business leads from Google Places and export exactly the fields you want (JSON, CSV, NDJSON). Ships as an npm CLI and standalone binaries.",
  "keywords": [
    "leads",
    "google-places",
    "cli",
    "prospecting",
    "export",
    "lead-generation"
  ],
  "license": "MIT",
  "author": "thmxsweb (https://github.com/thmxsweb)",
  "homepage": "https://github.com/thmxsweb/leadjet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thmxsweb/leadjet.git"
  },
  "bugs": {
    "url": "https://github.com/thmxsweb/leadjet/issues"
  },
  "type": "commonjs",
  "bin": {
    "leadjet": "dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "build:binaries": "pnpm run build && pkg . --targets node22-win-x64,node22-macos-x64,node22-linux-x64 --out-path release",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@thmxsweb/jj-sdk": "^0.4.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.7.5",
    "@yao-pkg/pkg": "^6.1.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
